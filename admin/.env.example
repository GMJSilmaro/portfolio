# PostgreSQL (Neon recommended). Use the pooled connection string for serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-secret"

# Single owner account (public registration is disabled)
OWNER_EMAIL="you@example.com"
# bcrypt hash of your password — generate with: pnpm hash-password
OWNER_PASSWORD_HASH="$2a$12$replace_with_bcrypt_hash_of_your_password"

# Vercel Cron authorization for /api/cron/cleanup-login-activity
CRON_SECRET="replace-with-long-random-secret"

# Optional: set automatically on Vercel
# VERCEL=1
# AUTH_TRUST_HOST=true
