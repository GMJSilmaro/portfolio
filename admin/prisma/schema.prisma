generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Successful owner admin login events (retained 30 days).
model LoginActivity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// Server-observed client IP (from Vercel trusted proxy headers).
  clientIp String @map("client_ip")

  /// Approximate IP-based location (never an exact address).
  ipCity          String? @map("ip_city")
  ipRegion        String? @map("ip_region")
  ipCountry       String? @map("ip_country")
  ipLocationSource LocationSource @default(UNAVAILABLE) @map("ip_location_source")
  ipLocationUnavailable Boolean @default(true) @map("ip_location_unavailable")

  browser String?
  os      String?
  userAgent String? @map("user_agent")

  /// Optional device geolocation (only after explicit user permission).
  deviceLatitude   Float?    @map("device_latitude")
  deviceLongitude  Float?    @map("device_longitude")
  deviceAccuracyM  Float?    @map("device_accuracy_m")
  deviceCapturedAt DateTime? @map("device_captured_at")
  deviceLocationSource DeviceLocationSource @default(NONE) @map("device_location_source")

  @@index([createdAt])
  @@map("login_activity")
}

enum LocationSource {
  VERCEL
  UNAVAILABLE
}

enum DeviceLocationSource {
  NONE
  BROWSER
  DENIED
  UNSUPPORTED
  TIMEOUT
  ERROR
}

/// Failed login attempts for rate limiting (no credentials stored).
model LoginAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  clientIp  String   @map("client_ip")
  success   Boolean  @default(false)

  @@index([clientIp, createdAt])
  @@map("login_attempt")
}
